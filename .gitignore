# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt
npm-debug.log*

/.angular
/.idea
/.ionic
/.sass-cache
/.sourcemaps
/.versions
/.vscode/*
!/.vscode/extensions.json
/coverage
/dist
/node_modules
/platforms
/plugins
/www

# Configuración local y secretos. Los archivos environment.ts versionados deben
# contener únicamente valores públicos y placeholders vacíos.
/.env
/.env.*
!/.env.example
/src/environments/*.local.ts
/src/environments/secrets.ts
/src/assets/config.local.json
